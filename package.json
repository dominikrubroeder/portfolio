{
  "name": "dominikrubroeder-dev",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --inspect",
    "dev-https": "next dev --experimental-https",
    "build": "npm run format && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --no-cache",
    "format": "prettier --write .",
    "upgrade-analytics@latest": "npm i @vercel/analytics@latest @vercel/speed-insights@latest --save-exact",
    "upgrade-animation@latest": "npm i motion@latest --save-exact",
    "upgrade-lint@latest": "npm i eslint@latest @eslint/eslintrc@latest --save-dev --save-exact",
    "upgrade-next@latest": "npm i next@latest eslint-config-next@latest --save-exact",
    "upgrade-react@latest": "npm i react@latest react-dom@latest @types/react@latest @types/react-dom@latest --save-exact",
    "upgrade-storybook@latest": "npx storybook@latest upgrade",
    "upgrade-tailwindcss@latest": "npm i tailwindcss@latest --save-dev --save-exact",
    "upgrade-tailwindcss-devtools@latest": "npm i prettier-plugin-tailwindcss@latest @tailwindcss/postcss@latest eslint-plugin-tailwindcss@latest --save-dev --save-exact && npm i tailwind-merge@latest tw-animate-css@latest --save-exact",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-react-parser": "5.2.8",
    "lucide-react": "1.26.0",
    "motion": "13.1.1",
    "next": "16.3.4",
    "prism-react-renderer": "2.4.1",
    "radix-ui": "^1.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-snowfall": "^2.3.0",
    "tailwind-merge": "3.6.0",
    "use-debounce": "10.0.4",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/eslintrc": "3.3.3",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-onboarding": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/nextjs-vite": "^10.5.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "10.0.1",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-storybook": "^10.5.6",
    "eslint-plugin-tailwindcss": "4.4.0",
    "playwright": "1.62.1",
    "postcss": "8.5.25",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.5.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
