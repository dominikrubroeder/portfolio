{
  "name": "dominikrubroeder-dev",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --inspect",
    "dev-https": "next dev --experimental-https",
    "build": "npm run format && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "cursors": "node scripts/generate-cursor-tokens.mjs",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --no-cache",
    "format": "prettier --write . && eslint . --fix",
    "upgrade-analytics@latest": "npm i @vercel/analytics@latest @vercel/speed-insights@latest --save-exact",
    "upgrade-animation@latest": "npm i motion@latest --save-exact",
    "upgrade-lint@latest": "npm i eslint@latest --save-dev --save-exact",
    "upgrade-next@latest": "npm i next@latest eslint-config-next@latest --save-exact",
    "upgrade-react@latest": "npm i react@latest react-dom@latest @types/react@latest @types/react-dom@latest --save-exact",
    "upgrade-storybook@latest": "npx storybook@latest upgrade",
    "upgrade-tailwindcss@latest": "npm i tailwindcss@latest --save-dev --save-exact",
    "upgrade-tailwindcss-devtools@latest": "npm i prettier-plugin-tailwindcss@latest @tailwindcss/postcss@latest --save-dev --save-exact && npm i tw-animate-css@latest --save-exact",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@heroicons/react": "2.2.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "lucide-react": "1.26.0",
    "motion": "14.2.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-snowfall": "2.3.0",
    "shadcn": "4.23.0",
    "use-debounce": "10.0.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-onboarding": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.25",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "playwright": "1.62.1",
    "postcss": "8.5.25",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.10"
  }
}
