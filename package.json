{
  "name": "dominikrubroeder-dev",
  "version": "2.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --inspect",
    "dev-https": "next dev --experimental-https",
    "build": "npm run format && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --no-cache",
    "format": "prettier --write .",
    "upgrade-analytics@latest": "npm i @vercel/analytics@latest @vercel/speed-insights@latest --save-exact",
    "upgrade-animation@latest": "npm i motion@latest --save-exact",
    "upgrade-lint@latest": "npm i eslint@latest @eslint/eslintrc@latest --save-dev --save-exact",
    "upgrade-next@latest": "npm i next@latest eslint-config-next@latest --save-exact",
    "upgrade-react@latest": "npm i react@latest react-dom@latest @types/react@latest @types/react-dom@latest --save-exact",
    "upgrade-storybook@latest": "npm i storybook@latest vite@latest vitest@latest @chromatic-com/storybook@latest @storybook/addon-a11y@latest @storybook/addon-docs@latest @storybook/addon-onboarding@latest @storybook/addon-vitest@latest @storybook/nextjs-vite@latest @vitest/browser-playwright@latest @vitest/coverage-v8@latest eslint-plugin-storybook@latest playwright@latest --save-exact --save-dev",
    "upgrade-tailwindcss@latest": "npm i tailwindcss@latest --save-dev --save-exact",
    "upgrade-tailwindcss-devtools@latest": "npm i prettier-plugin-tailwindcss@latest @tailwindcss/postcss@latest eslint-plugin-tailwindcss@beta --save-dev --save-exact && npm i tailwind-merge@latest tw-animate-css@latest --save-exact",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-react-parser": "5.2.8",
    "lucide-react": "0.525.0",
    "motion": "12.34.2",
    "next": "16.1.6",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-snowfall": "^2.3.0",
    "tailwind-merge": "3.5.0",
    "use-debounce": "10.0.4",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/eslintrc": "3.3.3",
    "@storybook/addon-a11y": "^10.1.4",
    "@storybook/addon-docs": "^10.1.4",
    "@storybook/addon-onboarding": "^10.1.4",
    "@storybook/addon-vitest": "^10.1.4",
    "@storybook/nextjs-vite": "^10.1.4",
    "@tailwindcss/postcss": "4.2.0",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.20",
    "eslint": "10.0.0",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-storybook": "^10.1.4",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "playwright": "^1.57.0",
    "postcss": "8.5.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "storybook": "10.2.10",
    "tailwindcss": "4.2.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5",
    "vite": "^7.2.6",
    "vitest": "^4.0.15"
  }
}
