{
  "name": "dominikrubroeder-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev-https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --no-cache",
    "format": "prettier --write .",
    "upgrade-next@latest": "npm i next@latest eslint-config-next@latest --legacy-peer-deps --save-exact",
    "upgrade-react@latest": "npm i react@latest react-dom@latest @types/react@latest @types/react-dom@latest --legacy-peer-deps --save-exact",
    "upgrade-tailwindcss@latest": "npm i tailwindcss@latest prettier-plugin-tailwindcss@latest @tailwindcss/postcss@latest --save-dev --legacy-peer-deps --save-exact && npm i tailwind-merge@latest tailwindcss-animate@latest --legacy-peer-deps --save-exact"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-select": "2.2.5",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-react-parser": "^5.2.2",
    "lucide-react": "0.511.0",
    "motion": "12.23.1",
    "next": "15.3.5",
    "prism-react-renderer": "2.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.34.2",
    "tailwind-merge": "3.3.1",
    "use-debounce": "10.0.4",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "4.1.10",
    "@types/node": "^20",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.3.5",
    "eslint-plugin-tailwindcss": "3.18.0",
    "postcss": "8.5.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "0.6.13",
    "tailwindcss": "4.1.10",
    "tw-animate-css": "1.3.5",
    "typescript": "^5"
  }
}
