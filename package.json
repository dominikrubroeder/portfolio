{
  "name": "dominikrubroeder-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev-https": "next dev --experimental-https",
    "build": "npm run format && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx --no-cache",
    "format": "prettier --write .",
    "upgrade-next@latest": "npm i next@latest eslint-config-next@latest --legacy-peer-deps --save-exact",
    "upgrade-react@latest": "npm i react@latest react-dom@latest @types/react@latest @types/react-dom@latest --legacy-peer-deps --save-exact",
    "upgrade-tailwindcss@latest": "npm i tailwindcss@latest --save-dev --legacy-peer-deps --save-exact",
    "upgrade-tailwindcss-devtools@latest": "npm i prettier-plugin-tailwindcss@latest @tailwindcss/postcss@latest eslint-plugin-tailwindcss@beta --save-dev --legacy-peer-deps --save-exact && npm i tailwind-merge@latest tw-animate-css@latest --legacy-peer-deps --save-exact",
    "upgrade-analytics@latest": "npm i @vercel/analytics @vercel/speed-insights --save-exact --legacy-peer-deps",
    "upgrade-lint@latest": "npm i eslint@latest @eslint/eslintrc@latest --save-dev --save-exact --legacy-peer-deps"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@radix-ui/react-dialog": "1.1.14",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-react-parser": "^5.2.2",
    "lucide-react": "0.525.0",
    "motion": "12.23.12",
    "next": "15.5.4",
    "prism-react-renderer": "2.4.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.34.2",
    "tailwind-merge": "3.3.1",
    "use-debounce": "10.0.4",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.12",
    "@types/node": "^20",
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.4",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "postcss": "8.5.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.13",
    "tw-animate-css": "1.3.7",
    "typescript": "^5"
  }
}
